# ---- hub ----
HUB_PORT=8080
HUB_HOST=0.0.0.0
# Public origin of the web UI (used for the WS origin check). e.g. https://ts.example.com
# The hub's own default is http://localhost:5173 (the Vite dev server); in the
# compose stack the UI is served by the hub itself, so use its public URL.
HUB_PUBLIC_ORIGIN=http://localhost:8080
# Random secret for signing the hub password cookie (openssl rand -hex 32).
# Required in production once HUB_PASSWORD is set; changing it logs everyone out.
HUB_SESSION_SECRET=change-me-to-a-long-random-string
# Password every browser must enter before it can use this hub. Empty = no
# password (anyone who can open the page can connect). Changing it logs
# everyone out.
HUB_PASSWORD=
# The one TeamSpeak server this hub connects to (host or host:port). When set,
# users only type a nickname: the address, the server password and the music
# bot come from here and whatever the browser sends is ignored. The host is
# also exempt from the private-range refusal, like HUB_ALLOWED_TS_SERVERS.
# Empty = users type the server address themselves.
HUB_TS_SERVER=
# Server password for HUB_TS_SERVER (leave empty if the server has none).
HUB_TS_PASSWORD=
# Host to dial for HUB_TS_SERVER's file port (TCP 30033 by default; the port
# itself comes from the server) when it is not the address HUB_TS_SERVER
# resolves to, e.g. the TeamSpeak box's LAN address while voice goes through
# its public name. Host only. Ignored without HUB_TS_SERVER.
HUB_FT_HOST=
# Extra browser origins allowed to open the websocket / write over the API
# (comma separated). HUB_PUBLIC_ORIGIN is always allowed; in development any
# localhost origin is too.
HUB_ALLOWED_ORIGINS=
# Trust X-Forwarded-For. Required behind the bundled Caddy, otherwise every
# session looks like it comes from the proxy and shares one per-IP budget.
# Never enable it when the hub is reachable directly: the header is then
# whatever the client says it is. Only hops from loopback/private addresses
# (where a reverse proxy lives) are believed.
HUB_TRUST_PROXY=1
# Optional: restrict which TeamSpeak servers browsers may connect to (comma separated host[:port]). Empty = any.
# Ignored when HUB_TS_SERVER is set.
HUB_ALLOWED_TS_SERVERS=
# Allow TeamSpeak targets on loopback/private ranges. Off in production (where
# it would make the hub a probe into its own network), on in development.
# Hosts named in HUB_ALLOWED_TS_SERVERS are exempt either way.
HUB_ALLOW_PRIVATE_TS_SERVERS=0
# Abuse ceilings. 0 disables the individual limit.
HUB_MAX_SESSIONS_PER_IP=10
HUB_HTTP_RATE_PER_MIN=300
HUB_CONNECT_RATE_PER_MIN=10
HUB_TTS_RATE_PER_MIN=30
HUB_MUSIC_RATE_PER_MIN=120
HUB_COMMAND_RATE_PER_MIN=600
HUB_TS_CMD_RATE_PER_MIN=120
# Channel file transfer: uploads and downloads stream through the hub to the
# TeamSpeak server's file port, which the hub must be able to reach. Largest
# upload in bytes (0 = no uploads), transfers one session may run at once,
# and transfer starts (download links + uploads) per session per minute.
HUB_FT_MAX_UPLOAD_BYTES=104857600
HUB_FT_MAX_TRANSFERS_PER_SESSION=3
HUB_FT_RATE_PER_MIN=30
# Chat video/audio streams through a media link: opening one and every seek a
# player makes start a transfer too. Each spends HUB_FT_RATE_PER_MIN above and,
# on top of it, this many per session per minute (0 = only the above applies).
HUB_FT_MEDIA_OPENS_PER_MIN=12
# Transfers the whole hub runs at once, and when one counts as stalled: fewer
# than HUB_FT_STALL_MIN_BYTES in HUB_FT_STALL_SECONDS is cut off (a trickling
# upload, a download nobody reads).
HUB_FT_MAX_TRANSFERS=32
HUB_FT_STALL_SECONDS=60
HUB_FT_STALL_MIN_BYTES=65536
# Bytes the hub-wide icon/avatar cache may hold (at least 1 MiB).
HUB_ASSET_CACHE_MAX_BYTES=67108864
# Default server shown in the connect form (unused when HUB_TS_SERVER is set)
HUB_DEFAULT_TS_SERVER=localhost:9987
# Directory of the built web UI the hub should serve. Empty = don't serve it
# (dev, where Vite serves the UI). The compose image sets this to /app/web.
HUB_STATIC_DIR=
# Where per-user profiles (avatar icon, entry sound) are stored.
HUB_DATA_DIR=./data
# trace | debug | info | warn | error | fatal
HUB_LOG_LEVEL=info
# 1 = human-readable colourised logs (dev); leave 0 for JSON logs in production.
HUB_LOG_PRETTY=0
# production | development
NODE_ENV=production

# ---- prebuilt image (docker-compose.ghcr.yml only) ----
# Which published hub image to run. The workflow pushes one image per repo,
# named after it; the web UI is inside it, served by the hub.
HUB_IMAGE=ghcr.io/jinzhongnyanne/ts-webui-hub
# latest = newest main build. Pin a release (v1.2.3) or a commit (sha-abc1234)
# for a server you do not want moving under you.
HUB_TAG=latest

# ---- music bot (teamspeak-music-bot) ----
# Only a DEFAULT: each user can name their own bot on the login screen.
# With HUB_TS_SERVER set users cannot, and this is the bot everybody gets.
# Base URL of the fallback bot's WebUI/API as reachable FROM THE HUB container.
# Leave empty to default to the TeamSpeak host on port 3000.
MUSICBOT_URL=http://musicbot:3000
# Optional service account created in the bot's WebUI (role: member is enough).
# Used only for MUSICBOT_URL; any other bot is joined in guest mode.
# Leave both empty to use the bot's guest mode instead (must be enabled by the bot admin).
MUSICBOT_USERNAME=
MUSICBOT_PASSWORD=
# Set to 1 if the bot serves a self-signed or expired HTTPS certificate.
MUSICBOT_INSECURE_TLS=0

# ---- video / screen share ----
# auto = LiveKit when fully configured below, otherwise browser-to-browser mesh (no extra server)
# mesh | livekit | off are also accepted
RTC_MODE=auto
# STUN servers used by the mesh mode (comma separated)
RTC_STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
# Optional TURN relay for peers behind strict NAT (e.g. coturn)
RTC_TURN_URLS=
RTC_TURN_USERNAME=
RTC_TURN_PASSWORD=

# ---- LiveKit (optional SFU for large rooms) ----
LIVEKIT_URL=ws://livekit:7880
# URL the BROWSER uses to reach LiveKit. In production this must be
# wss://<domain>/livekit (Caddy terminates TLS and proxies it); ws:// only works
# for a local, non-HTTPS dev setup.
LIVEKIT_PUBLIC_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret-must-be-at-least-32-characters-long

# ---- Caddy (prod only) ----
DOMAIN=ts.example.com
