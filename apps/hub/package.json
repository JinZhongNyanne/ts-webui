{
  "name": "@jinz/hub",
  "version": "0.1.0",
  "private": true,
  "description": "Gateway between browsers and TeamSpeak servers, plus music-bot BFF and LiveKit token service",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/static": "^10.1.3",
    "@fastify/websocket": "^11.3.0",
    "@honeybbq/teamspeak-client": "^0.2.3",
    "@jinz/protocol": "*",
    "fastify": "^5.12.4",
    "livekit-server-sdk": "^2.19.0",
    "msedge-tts": "^2.0.7",
    "pino": "^10.3.1",
    "undici": "^7.29.1",
    "ws": "^8.21.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "@types/ws": "^8.18.1",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.13",
    "typescript": "^5.9.0",
    "vitest": "^5.0.1"
  }
}
